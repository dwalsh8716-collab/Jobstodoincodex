APP_ENV=development
APP_BASE_URL=http://localhost:3005
API_BASE_URL=http://localhost:8005

DATABASE_URL=sqlite:///./data/interview_agent.db
REDIS_URL=redis://localhost:6379/0

APP_LOGIN_EMAIL=david@example.com
APP_LOGIN_PASSWORD=replace-this-local-password
SESSION_SECRET=replace-this-with-a-long-random-secret
ENCRYPTION_KEY=replace-this-before-production

DEFAULT_TIMEZONE=Europe/London
WORKING_HOURS_START=08:00
WORKING_HOURS_END=18:00
DEFAULT_INTERVIEW_START=09:00
DEFAULT_INTERVIEW_END=17:30
MAX_AUTOMATED_CHASES=2
AI_CONFIDENCE_THRESHOLD=0.82
ENABLE_AUTOMATION_WORKER=true
WORKER_DUE_WORK_INTERVAL_SECONDS=300
WORKER_GMAIL_SYNC_INTERVAL_SECONDS=300
LOGIN_RATE_LIMIT_ATTEMPTS=8
PUBLIC_RATE_LIMIT_ATTEMPTS=40

EMAIL_PROVIDER=mock
CALENDAR_PROVIDER=mock
CRM_CONNECTOR=manual
ENABLE_GMAIL_REPLY_SYNC=true

# Optional local real-email testing. For production use Gmail API or Microsoft
# Graph, but SMTP is useful for a controlled test from a real mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=David Walsh
SMTP_USE_TLS=true
SMTP_USE_SSL=false

OPENAI_API_KEY=
OPENAI_MODEL=

# Google OAuth for Gmail sending, Gmail reply sync, Google Calendar and Meet.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8005/api/integrations/google/callback
GOOGLE_OAUTH_HOSTED_DOMAIN=essentialresourcing.co.uk
GOOGLE_OAUTH_LOGIN_HINT=
GOOGLE_CALENDAR_ID=primary

# Keep this false for normal candidate/client interview scheduling.
# Turn it on only when the recruiter is actually attending interviews and wants
# their own calendar to block proposed slots.
CHECK_RECRUITER_CALENDAR_CONFLICTS=false
