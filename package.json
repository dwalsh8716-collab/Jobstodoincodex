{
  "name": "essential-resourcing",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "qa:production": "node scripts/production-qa-audit.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "clean:next-dev-types": "node scripts/clean-next-dev-types.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:status": "node scripts/db-status.mjs",
    "retention:check": "node scripts/retention-check.mjs --dry-run",
    "retention:apply": "node scripts/retention-check.mjs --apply",
    "retention:cv:check": "node scripts/cv-retention-review.mjs",
    "retention:cv:apply": "node scripts/cv-retention-review.mjs --apply",
    "performance:budget": "node scripts/performance-budget.mjs",
    "seo:audit": "node scripts/seo-launch-audit.mjs",
    "whatsapp:verify": "node scripts/verify-whatsapp-business-api.mjs",
    "sanity:sync-copy": "sanity exec scripts/sync-approved-copy-to-sanity.mjs --with-user-token",
    "sanity:sync-copy:dry-run": "sanity exec scripts/sync-approved-copy-to-sanity.mjs --with-user-token -- --dry-run",
    "sanity:verify-copy": "sanity exec scripts/sync-approved-copy-to-sanity.mjs --with-user-token -- --verify",
    "sanity:seed-hub-pages": "sanity exec scripts/seed-content-hub-pages.mjs --with-user-token",
    "health:monthly": "node scripts/monthly-health-check.mjs",
    "monitor:production": "node scripts/production-monitor.mjs",
    "verify": "npm run lint && npm run build && npm run clean:next-dev-types && npm run typecheck && npm run test && npm run performance:budget && playwright test",
    "sanity": "sanity"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@sanity/client": "8.6.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "6.16.0",
    "@sanity/webhook": "4.0.4",
    "@sentry/nextjs": "^10.75.1",
    "next": "16.3.5",
    "next-sanity": "^13.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "6.16.0",
    "server-only": "^0.0.1",
    "styled-components": "6.5.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@sanity/uuid": {
      "uuid": "^11.1.1"
    },
    "@vercel/frameworks": {
      "js-yaml": "^3.14.2",
      "smol-toml": "^1.7.0"
    },
    "next": {
      "postcss": "^8.5.15"
    },
    "vite": {
      "esbuild": "^0.28.1"
    },
    "adm-zip": "0.6.1",
    "undici": "7.29.0",
    "@module-federation/vite": "1.21.6",
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}
