BD_DB_PATH=data/bd_intelligence.sqlite3

# Optional. Without this, the app uses clear local fallback drafts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional search sources.
# Google's older Custom Search JSON API is closed to new customers, so SerpAPI
# is often the simpler Google-search route for new setups.
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Optional Gmail alert import.
# Create a Gmail label such as "LinkedIn Job Alerts" and filter LinkedIn job
# alert emails into it. Use either a Gmail app password or replace this later
# with a fuller Google OAuth setup.
GMAIL_IMAP_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_FOLDER=LinkedIn Job Alerts
GMAIL_SEARCH_CRITERIA=ALL
GMAIL_MAX_EMAILS=25
